    {
      "id": "readme_adding_new_tool",
      "label": "Convention: adding a new tool (folder + index.html + shared stylesheet + card)",
      "file_type": "rationale",
      "source_file": "E:\\Simple Tools\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Every tool lives in its own folder with a single index.html linking the shared stylesheet, so new tools stay visually consistent and can be added with a fixed 4-step recipe (create folder, link stylesheet, add card to root index.html, commit) without a build step."
    },
    {
      "id": "readme_bilingual_convention",
      "label": "Bilingual EN/ID convention via SiteLang + localStorage",
      "file_type": "rationale",
      "source_file": "E:\\Simple Tools\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Language choice is stored once in localStorage under site.lang and shared across every page; first-time visitors with an id-* browser locale default to Indonesian, otherwise English — avoids re-prompting returning visitors and keeps all bilingual pages behaviorally identical."
    },
